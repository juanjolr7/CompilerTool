public class pera{
public static void Area(int a, double b){
double area =a*b/2;
return area;
}
public static int perimetro (int x, int y){
if(x=='a'){
return x +3.1416;
}
return y+2*3.1416;
}
public static void main(){
int a=5.0;
int b=10;
float area;
area = #Area(a,b);
System.out.println(area);
int x=10;
double y=20;
int p;
p = #perimetro(x,y);
System.out.println(p);
}

}